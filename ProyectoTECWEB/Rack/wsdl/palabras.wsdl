<definitions name="PalabrasService"
             targetNamespace="http://example.com/palabras"
             xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:tns="http://example.com/palabras"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <message name="obtenerFrecuentesRequest"/>
  <message name="obtenerFrecuentesResponse">
    <part name="resultado" type="xsd:string"/>
  </message>

  <message name="obtenerPopularesRequest"/>
  <message name="obtenerPopularesResponse">
    <part name="resultado" type="xsd:string"/>
  </message>

  <portType name="PalabrasPortType">
    <operation name="obtenerFrecuentes">
      <input message="tns:obtenerFrecuentesRequest"/>
      <output message="tns:obtenerFrecuentesResponse"/>
    </operation>
    <operation name="obtenerPopulares">
      <input message="tns:obtenerPopularesRequest"/>
      <output message="tns:obtenerPopularesResponse"/>
    </operation>
  </portType>

  <binding name="PalabrasBinding" type="tns:PalabrasPortType">
    <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="obtenerFrecuentes">
      <soap:operation soapAction="obtenerFrecuentes"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="obtenerPopulares">
      <soap:operation soapAction="obtenerPopulares"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>

  <service name="PalabrasService">
    <port name="PalabrasPort" binding="tns:PalabrasBinding">
      <soap:address location="http://localhost:8001/wsdl"/>
    </port>
  </service>
</definitions>
